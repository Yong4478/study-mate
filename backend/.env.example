# ─────────────────────────────────────────────────────────────
#  이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
#  cp .env.example .env      (윈도우: copy .env.example .env)
#  ⚠️ .env 와 firebase-key.json 은 절대 GitHub에 올리지 마세요! (.gitignore 에 등록됨)
# ─────────────────────────────────────────────────────────────

# [AI] 경남 코디세이에서 받은 키 (OpenAI 호환 방식) - = 뒤에 따옴표 없이 붙여넣기
OPENAI_API_KEY=
# 코디세이 API 주소 (콘솔 > 문서 탭의 'Cursor/OpenAI Base URL'). 콘솔 웹페이지 주소(usr.codyssey.kr/...)가 아님!
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# 사용할 모델 ID (콘솔 > 문서 탭 '모델별 차감 가중치' 표의 OPENAI CHAT 모델). gpt-5-mini 는 차감 0.5배로 저렴
OPENAI_MODEL=gpt-5-mini
# 답변 최대 토큰 (gpt-5 계열은 '생각'에도 토큰을 써서 1500 정도 권장)
OPENAI_MAX_TOKENS=1500
# (선택) 코디세이 사용량을 이 이름으로 묶어서 보기 (X-Codyssey-Session-Id 헤더)
CODYSSEY_SESSION_ID=study-mate

# [Firebase] 둘 중 하나만 설정
# 로컬: 다운로드한 서비스 계정 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json
# 배포(Render): Render 대시보드 Environment 에 키 파일 내용 전체({ ~ })를 붙여넣기 (로컬에서는 위 PATH 방식 추천)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# [CORS] 프론트엔드 주소 (쉼표로 구분, 끝에 / 없이)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# (선택) Vercel 미리보기 주소 허용용 정규식
# ALLOWED_ORIGIN_REGEX=https://study-mate-.*\.vercel\.app

# [서비스] 하루 목표 공부 시간(분)
DAILY_GOAL_MINUTES=120
# [과금 보호] AI 호출 횟수 제한 (IP당 1분 / 서버 전체 하루)
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=200
# [과금 보호] 이번 달 AI 토큰 사용 한도 (Firestore usage 컬렉션에 누적, 매월 초기화, 0=제한 없음)
TOKEN_LIMIT=100000
